MYSQL_DATABASE=sakezuki
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=sakezuki
MYSQL_PASSWORD=YOUR_PASSWORD
MYSQL_ROOT_PASSWORD=YOUR_ROOT_PASSWORD
GEMINI_API_KEY=YOUR_Gemini_API_Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/login/oauth2/code/google
AUTH_FRONTEND_URL=http://localhost:3000
AUTH_SECURE_COOKIES=false

# 공개 배포 시 인증서와 도메인을 정하고 HTTPS 구성을 함께 적용한다.
# COMPOSE_FILE=docker-compose.yaml:compose.https.yaml
# PUBLIC_HOST=
# TLS_CERT_DIR=/absolute/path/to/certificates
# HEALTHCHECK_URL=https://PUBLIC_HOST/api/health/ready
CREDITS_INITIAL_GRANT=10
CREDITS_HISTORY_RETENTION=30d
CREDITS_RESERVATION_TIMEOUT=10m
CREDITS_DAILY_GENERATION_LIMIT=100

# 계약된 서버용 Provider와 승인된 약관이 준비되기 전에는 빈 상태로 둔다.
IDENTITY_HASH_KEY=
IDENTITY_TERMS_VERSION=
IDENTITY_PRIVACY_VERSION=
IDENTITY_TERMS_URL=
IDENTITY_PRIVACY_URL=
IDENTITY_PROVIDER_ORIGIN=
